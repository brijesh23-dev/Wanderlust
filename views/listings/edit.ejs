```ejs
<% layout('layouts/boilerplate') %>
<body>
  <div class="row">
    <div class="col-12 col-md-8 offset-md-2">
      <h3>Edit your listings</h3>
      <form
        method="POST"
        action="/listings/<%= listing._id%>?_method=PUT"
        enctype="multipart/form-data"
      >
        <div class="mb-3">
          <label for="title" class="form-label">Title</label>
          <input
            type="text"
            name="listing[title]"
            id="title"
            value="<%= listing.title %>"
            class="form-control"
          />
        </div>

        <div class="mb-3">
          <label for="description" class="form-label">Description</label>
          <textarea
            name="listing[description]"
            class="form-control"
            id="description"
          ><%= listing.description %></textarea>
        </div>

        <div class="mb-3" id="upload_img">
          <h5>Original image</h5>
          <img src="<%= listingOriginalUrl %>" alt="" />
        </div>

        <div class="mb-3">
          <label for="image-link" class="form-label">
            Update new image
          </label>
          <input
            type="file"
            name="listing[image]"
            class="form-control"
            id="image-link"
          />
        </div>

        <div class="mb-3">
          <label for="price" class="form-label">Price</label>
          <input
            type="number"
            name="listing[price]"
            value="<%= listing.price %>"
            class="form-control"
            id="price"
          />
        </div>

        <div class="mb-3">
          <label for="location" class="form-label">Location</label>
          <input
            type="text"
            name="listing[location]"
            value="<%= listing.location %>"
            class="form-control"
            id="location"
          />
        </div>

        <div class="mb-3">
          <label for="country" class="form-label">Country</label>
          <input
            type="text"
            name="listing[country]"
            value="<%= listing.country %>"
            class="form-control"
            id="country"
          />
        </div>

        <div class="mb-3">
          <label for="latitude" class="form-label">Latitude</label>
          <input
            type="number"
            step="any"
            name="listing[latitude]"
            value="<%= listing.geometry.coordinates[1] %>"
            class="form-control"
            id="latitude"
            required
          />
        </div>

        <div class="mb-3">
          <label for="longitude" class="form-label">Longitude</label>
          <input
            type="number"
            step="any"
            name="listing[longitude]"
            value="<%= listing.geometry.coordinates[0] %>"
            class="form-control"
            id="longitude"
            required
          />
        </div>

        <div class="mb-3">
          <label class="form-label">Select location on map</label>
          <div id="map"></div>
        </div>

        <br />
        <button class="btn btn-dark edit-btn mb-2">Update</button>
      </form>
    </div>
  </div>

  <script src="/leaflet/leaflet.js"></script>
  <script src="/js/map.js"></script>
</body>
```