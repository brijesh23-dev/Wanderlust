<% layout('layouts/boilerplate') %>
<main class="auth-page">
  <div class="auth-card">
    <div class="auth-heading">
      <span class="auth-icon" aria-hidden="true"><i class="fa-regular fa-compass"></i></span>
      <p class="auth-eyebrow">Start your journey</p>
      <h1>Join Wanderlust</h1>
      <p class="auth-subtitle">Create an account to discover your next stay.</p>
    </div>
    <form action="/signup" method="POST" class="needs-validation auth-form" novalidate>
      <div class="mb-3">
        <label for="username" class="form-label">Username</label>
        <input
          type="username"
          name="username"
          id="username"
          class="form-control"
          required
        />
      </div>
      <div class="valid-feedback">looks good</div>
      <div class="mb-3">
        <label for="email" class="form-label">Email address</label>
        <input
          type="email"
          name="email"
          id="email"
          class="form-control"
          required
        />
      </div>
      <div class="mb-3">
        <label for="password" class="form-label">Password</label>
        <input
          type="password"
          name="password"
          id="password"
          class="form-control"
          required
        />
        <div class="valid-feedback">looks good</div>
      </div>
      <button class="btn auth-submit mb-2">Create account</button>
    </form>
    <p class="auth-switch">Already have an account? <a href="/login">Log in</a></p>
  </div>
</main>
