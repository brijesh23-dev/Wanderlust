 
<% layout("/layouts/boilerplate") %>

<div class="container mt-4 mb-5">

    <!-- Wishlist heading -->
    <div class="mb-4">
        <h2 class="fw-bold">My Wishlist</h2>
        <p class="text-muted mb-0">Your favourite stays, all in one place.</p>
        <p id="wishlist-count" class="mt-2">0 saved listings</p>
    </div>

    <!-- Wishlist listings -->
    <div
        id="wishlist-container"
        class="row row-cols-lg-3 row-cols-md-2 row-cols-1 g-4"
    >
    </div>

    <!-- Empty wishlist state -->
    <div id="empty-wishlist" class="text-center py-5 d-none">
        <h4 class="fw-semibold">Your wishlist is empty</h4>
        <p class="text-muted">
            Start exploring and save the stays you love.
        </p>

        <a href="/listings" class="btn btn-dark mt-2">
            Explore Listings
        </a>
    </div>

    <!-- Loading state -->
    <div id="wishlist-loading" class="text-center py-5">
        <div class="spinner-border" role="status">
            <span class="visually-hidden">Loading...</span>
        </div>
        <p class="text-muted mt-2">Loading your wishlist...</p>
    </div>

</div>