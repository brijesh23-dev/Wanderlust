<% layout('layouts/boilerplate') %>
<main class="auth-page">
  <div class="auth-card">
    <div class="auth-heading">
      <span class="auth-icon" aria-hidden="true"><i class="fa-regular fa-compass"></i></span>
      <p class="auth-eyebrow">Welcome back</p>
      <h1>Log in to Wanderlust</h1>
      <p class="auth-subtitle">Continue exploring places worth remembering.</p>
    </div>
    <form action="/login" method="POST" class="needs-validation auth-form" novalidate>
      <div class="mb-3">
        <label for="username" class="form-label">Username</label>
        <input
          type="username"
          name="username"
          id="username"
          class="form-control"
          required
        />
      </div>
      <div class="mb-3">
        <label for="password" class="form-label">Password</label>
        <input
          type="password"
          name="password"
          id="password"
          class="form-control"
          required
        />
      </div>
      <button class="btn auth-submit mb-2">Log in</button>
    </form>
    <p class="auth-switch">New to Wanderlust? <a href="/signup">Create an account</a></p>
  </div>
</main>
