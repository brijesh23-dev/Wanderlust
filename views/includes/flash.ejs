<script>
    const successMessages = <%- JSON.stringify(success || []) %>;
    const errorMessages = <%- JSON.stringify(error || []) %>;

    successMessages.forEach(message => {
        Toastify({
            text: message,
            duration: 3000,
            gravity: "top",
            position: "right",
            close: true,
            stopOnFocus: true,
            style: {
                background: "#16a34a",
                borderRadius: "8px"
            }
        }).showToast();
    });

    errorMessages.forEach(message => {
        Toastify({
            text: message,
            duration: 4000,
            gravity: "top",
            position: "right",
            close: true,
            stopOnFocus: true,
            style: {
                background: "#dc2626",
                borderRadius: "8px"
            }
        }).showToast();
    });
</script>