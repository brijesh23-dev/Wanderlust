<% layout('layouts/boilerplate') %>
<script>
  document.addEventListener("DOMContentLoaded", () => {
    Toastify({
      text: "<%= err.message %>",
      duration: 4000,
      gravity: "top",
      position: "right",
      close: true,
      style: {
        background: "#dc2626",
        borderRadius: "8px"
      }
    }).showToast();
  });
</script>
